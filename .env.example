# ==============================================================================
# SwipeX Milestone 4 — Master Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env' for local Docker Compose or local microservice development:
#      cp .env.example .env
# 2. Never commit '.env' or any live secrets to version control.
# 3. For production deployment on Render, refer to the comments above each variable
#    indicating whether it is managed by the Blueprint (render.yaml) or set in
#    the Render Dashboard under Environment variables.
# ==============================================================================

# ==============================================================================
# 1. Global Platform, Host & Ingress Configuration
# ==============================================================================
# Production: Injected dynamically by Render ($PORT = 10000). Set in local .env only.
PORT=8001
HOST=0.0.0.0

# CORS Allow-list: In production, set to your frontend domain in Render dashboard or Blueprint.
# Local / Dev: http://localhost:3000 or *
# Render: https://swipex-frontend.onrender.com
CORS_ORIGINS=*

# ==============================================================================
# 2. PostgreSQL Databases Configuration
# ==============================================================================
# Local Docker Compose defaults:
POSTGRES_USER=swipex
# PRODUCTION: Managed automatically by Render PostgreSQL Blueprint.
# Local dev placeholder:
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Database Connection URLs:
# Production: Render Blueprint auto-wires fromDatabase property 'connectionString'.
# Docker compose dev network:
DATABASE_URL=postgresql://swipex:replace-with-strong-db-password@postgres:5432/swipex_auth
AUTH_DATABASE_URL=postgresql://swipex:replace-with-strong-db-password@postgres:5432/swipex_auth
JOB_DATABASE_URL=postgresql://swipex:replace-with-strong-db-password@postgres:5432/swipex_job

# ==============================================================================
# 3. Redis Cache & Real-Time Event Bus
# ==============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
# Production: Render Blueprint auto-wires fromService type 'keyvalue' connectionString.
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TIMEOUT=5

# ==============================================================================
# 4. Auth Service & API Gateway (Port 8001) — Intern 2
# ==============================================================================
# Production: Render Blueprint generates random 256-bit keys via 'generateValue: true'.
# In local development, use safe placeholder strings:
JWT_SECRET_KEY=replace-with-long-random-jwt-secret-string
SESSION_SECRET_KEY=replace-with-long-random-session-secret-string

# Inter-service HMAC authorization token between Gateway and Microservices.
# Production: Render Blueprint generates via 'generateValue: true' and shares via fromService.
GATEWAY_SHARED_SECRET=replace-with-internal-gateway-shared-secret
TRUST_GATEWAY_HEADERS=true

# Downstream Microservice Discovery URLs
# Local Compose: http://job-data-service:8002 and http://resume-service:8003
# Render Production: Auto-wired via render.yaml service endpoints
JOB_SERVICE_URL=http://job-data-service:8002
RESUME_SERVICE_URL=http://resume-service:8003
MATCHING_ENGINE_URL=http://resume-service:8003

# Google OAuth2 Credentials (Optional: required only for Google Sign-In flow)
# Production: Set in Render Dashboard (GOOGLE_CLIENT_SECRET as secret with sync: false)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# Ingress Rate Limiting
MAX_REQUESTS_PER_MINUTE=120

# ==============================================================================
# 5. Job & Data Intelligence Service (Port 8002) — Intern 3
# ==============================================================================
EARLY_APPLICANT_WINDOW_HOURS=48
SWIPEX_USE_LIVE_CLOCK=false
SWIPEX_REF_TIMESTAMP=2025-01-01T00:00:00Z
RAW_DATASET1_PATH=data/raw/indian-job-market-dataset-2025 processed.xlsx
SWIPEX_AUTH_MODE=relaxed
RESUME_STORAGE_DIR=uploads/resumes

# ==============================================================================
# 6. AI/ML & Resume Intelligence Service (Port 8003) — Intern 4
# ==============================================================================
RESUME_UPLOAD_DIR=uploads/resumes
MAX_RESUME_SIZE_MB=5

# MinIO S3-Compatible Storage (Optional storage profile for local Docker stack)
MINIO_ROOT_USER=swipex_minio
MINIO_ROOT_PASSWORD=replace-with-strong-minio-root-password
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_NAME=swipex-resumes
MINIO_USE_SSL=false

# ChromaDB Vector Store (Optional storage profile for local Docker stack)
CHROMADB_HOST=localhost
CHROMADB_PORT=8004

# ==============================================================================
# 7. Notifications & Alerting (Milestone 4)
# ==============================================================================
# Production: Set in Render Dashboard (SMTP_PASSWORD and VAPID_PRIVATE_KEY as secrets)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=replace-with-smtp-password
VAPID_PUBLIC_KEY=replace-with-public-vapid-key
VAPID_PRIVATE_KEY=replace-with-private-vapid-key
VAPID_CLAIMS_EMAIL=admin@swipex.careers

# ==============================================================================
# 8. Frontend Web Client (Port 3000 / 5173) — Intern 1
# ==============================================================================
# NOTE: VITE_* variables are baked into the public browser bundle at build time.
# NEVER store private secrets, private keys, or database credentials in VITE_* vars.
VITE_BASE_API_URL=http://localhost:8001/api/v1
VITE_WS_URL=ws://localhost:8001/api/v1/notifications/ws
VITE_USE_MOCK=false
VITE_SHOW_DEV_TOOLS=false
VITE_ENABLE_PUSH=false

# Firebase Web Client SDK Configuration (Optional - Public Client Identifiers only)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_VAPID_KEY=

# ==============================================================================
# 9. CI/CD & Production Deployment (GitHub Actions Secrets & Variables)
# ==============================================================================
# Do NOT place these in .env. Store these in GitHub Repository Settings:
# - GitHub Secrets (Settings -> Secrets and variables -> Actions -> Repository secrets):
#     RENDER_DEPLOY_HOOK_GATEWAY: https://api.render.com/deploy/srv-xxx?key=yyy
#     RENDER_DEPLOY_HOOK_JOB:     https://api.render.com/deploy/srv-xxx?key=yyy
#     RENDER_DEPLOY_HOOK_RESUME:  https://api.render.com/deploy/srv-xxx?key=yyy
#     RENDER_DEPLOY_HOOK_FRONTEND: https://api.render.com/deploy/srv-xxx?key=yyy
# - GitHub Variables (Settings -> Secrets and variables -> Actions -> Repository variables):
#     RENDER_BASE_URL: https://swipex-auth-gateway.onrender.com
