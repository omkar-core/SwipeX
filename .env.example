# SwipeX Milestone 1 — Master Environment Configuration Template
# Copy this file to .env before running docker compose or local services

# ==============================================================================
# PostgreSQL Databases Configuration
# ==============================================================================
POSTGRES_USER=swipex
POSTGRES_PASSWORD=swipex
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Database URLs (used inside Docker network; replace 'postgres' with 'localhost' for host-local testing)
AUTH_DATABASE_URL=postgresql://swipex:swipex@postgres:5432/swipex_auth
JOB_DATABASE_URL=postgresql://swipex:swipex@postgres:5432/swipex_job

# ==============================================================================
# Redis Cache Configuration
# ==============================================================================
REDIS_HOST=redis
REDIS_PORT=6379

# ==============================================================================
# Auth Service & API Gateway (Port 8001)
# ==============================================================================
JWT_SECRET_KEY=dev-jwt-secret-key-swipex-team4-2026-integration
SESSION_SECRET_KEY=dev-session-secret-key-swipex-team4-2026-oauth
JOB_SERVICE_URL=http://job-data-service:8002
RESUME_SERVICE_URL=http://resume-service:8003

# Optional: Google OAuth2 Credentials (Leave blank if testing email/password only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ==============================================================================
# Job & Data Intelligence Service (Port 8002)
# ==============================================================================
GATEWAY_SHARED_SECRET=swipex-internal-gateway-secret
TRUST_GATEWAY_HEADERS=true

# ==============================================================================
# Frontend Client Configuration (Port 3000 / 5173)
# ==============================================================================
VITE_BASE_API_URL=http://localhost:8001/api/v1
VITE_USE_MOCK=false
