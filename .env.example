# SwipeX Milestone 4 — Master Environment Configuration Template
# Copy this file to .env before running docker compose, local development, or Render deployment.

# ==============================================================================
# Service Ports & Host Routing (Local & Docker)
# ==============================================================================
PORT=8001
HOST=0.0.0.0
CORS_ORIGINS=*

# ==============================================================================
# PostgreSQL Databases Configuration
# ==============================================================================
POSTGRES_USER=swipex
POSTGRES_PASSWORD=swipex
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Database URLs (Docker network: replace 'postgres' with 'localhost' or Render Postgres URL)
DATABASE_URL=postgresql://swipex:swipex@postgres:5432/swipex_auth
AUTH_DATABASE_URL=postgresql://swipex:swipex@postgres:5432/swipex_auth
JOB_DATABASE_URL=postgresql://swipex:swipex@postgres:5432/swipex_job

# ==============================================================================
# Redis Cache & Real-Time Event Bus
# ==============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ==============================================================================
# Auth Service & API Gateway (Port 8001) — Intern 2
# ==============================================================================
JWT_SECRET_KEY=dev-jwt-secret-key-swipex-team4-2026-integration
SESSION_SECRET_KEY=dev-session-secret-key-swipex-team4-2026-oauth
GATEWAY_SHARED_SECRET=swipex-internal-gateway-secret
TRUST_GATEWAY_HEADERS=true

# Downstream Microservice Discovery
JOB_SERVICE_URL=http://job-data-service:8002
RESUME_SERVICE_URL=http://resume-service:8003
MATCHING_ENGINE_URL=http://resume-service:8003

# Google OAuth2 Credentials (Optional: required only for Google Sign-In)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Rate Limiting & Security
MAX_REQUESTS_PER_MINUTE=120

# ==============================================================================
# Job & Data Intelligence Service (Port 8002) — Intern 3
# ==============================================================================
EARLY_APPLICANT_WINDOW_HOURS=48
SWIPEX_USE_LIVE_CLOCK=false
SWIPEX_REF_TIMESTAMP=2025-01-01T00:00:00Z
RAW_DATASET1_PATH=data/raw/indian-job-market-dataset-2025 processed.xlsx

# ==============================================================================
# AI/ML & Resume Intelligence Service (Port 8003) — Intern 4
# ==============================================================================
RESUME_UPLOAD_DIR=uploads/resumes
MAX_RESUME_SIZE_MB=5

# MinIO S3-Compatible Storage (Optional storage profile)
MINIO_ROOT_USER=swipex_minio
MINIO_ROOT_PASSWORD=swipex_minio_dev_password
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_NAME=swipex-resumes
MINIO_USE_SSL=false

# ChromaDB Vector Store (Optional storage profile)
CHROMADB_HOST=localhost
CHROMADB_PORT=8004

# ==============================================================================
# Notifications & Alerting (Milestone 4)
# ==============================================================================
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=admin@swipex.careers

# ==============================================================================
# Frontend Web Client (Port 3000 / 5173) — Intern 1
# ==============================================================================
VITE_BASE_API_URL=http://localhost:8001/api/v1
VITE_WS_URL=ws://localhost:8001/api/v1/notifications/ws
VITE_USE_MOCK=false

# ==============================================================================
# Render Production Deployment Guidance
# ==============================================================================
# In Render Web Service settings, configure:
# - Frontend: VITE_BASE_API_URL=https://swipex-auth-gateway.onrender.com/api/v1
# - Frontend: VITE_WS_URL=wss://swipex-auth-gateway.onrender.com/api/v1/notifications/ws
# - Gateway: CORS_ORIGINS=https://swipex-frontend.onrender.com
# - Gateway: JOB_SERVICE_URL=http://swipex-job-service:8002 (or internal service DNS)
# - Gateway: RESUME_SERVICE_URL=http://swipex-resume-service:8003
