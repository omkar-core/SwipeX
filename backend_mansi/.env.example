# Copy to .env and fill in once ready. Leave unset during early dev —
# the service falls back to SQLite and OAuth login simply won't work yet.

DATABASE_URL=postgresql://swipex:swipex@localhost:5432/swipex_auth

# JWT signing key — use a long random string in real environments
JWT_SECRET_KEY=change-me-to-something-random

# Needed for Google OAuth2 login (Day 3). Get these from:
# https://console.cloud.google.com/apis/credentials
# Create an "OAuth 2.0 Client ID" (Web application), and add this as an
# Authorized redirect URI: http://localhost:8001/api/v1/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Used by Authlib to sign the temporary OAuth session cookie
SESSION_SECRET_KEY=change-me-too

# Where the Gateway forwards requests (Day 4) — update once teammates'
# services are running
JOB_SERVICE_URL=http://localhost:8002
RESUME_SERVICE_URL=http://localhost:8003
