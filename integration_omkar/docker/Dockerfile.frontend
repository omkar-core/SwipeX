# Node.js 20 image for Frontend Web Application (frontend_boomika)
FROM node:20-alpine

WORKDIR /app

COPY frontend_boomika/package*.json ./
RUN npm ci

COPY frontend_boomika/ .

EXPOSE 3000

ENV VITE_BASE_API_URL=http://localhost:8001/api/v1
ENV VITE_USE_MOCK=false

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "3000"]
